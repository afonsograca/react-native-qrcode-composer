{
  "name": "react-native-qrcode-composer",
  "version": "0.3.0",
  "description": "A customizable QR code component for React Native, rendered with SVG.",
  "author": "Afonso Graça",
  "packageManager": "yarn@4.17.1",
  "scripts": {
    "prepare": "bob build",
    "release": "release-it",
    "typecheck": "tsc --noEmit -p tsconfig.build.json",
    "lint": "eslint .",
    "format": "prettier --write src",
    "test": "jest"
  },
  "main": "lib/commonjs/index.js",
  "module": "lib/module/index.js",
  "react-native": "src/index.tsx",
  "types": "lib/typescript/index.d.ts",
  "source": "src/index.tsx",
  "exports": {
    ".": {
      "types": "./lib/typescript/index.d.ts",
      "react-native": "./src/index.tsx",
      "source": "./src/index.tsx",
      "require": "./lib/commonjs/index.js",
      "default": "./lib/commonjs/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "src",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "/README.md",
    "/LICENSE",
    "/CHANGELOG.md"
  ],
  "keywords": [
    "react-native",
    "qrcode",
    "qr code",
    "svg",
    "react-native-qrcode-svg",
    "react-native-qrcode",
    "qrcode-composer"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/afonsograca/react-native-qrcode-composer.git"
  },
  "homepage": "https://github.com/afonsograca/react-native-qrcode-composer#readme",
  "bugs": {
    "url": "https://github.com/afonsograca/react-native-qrcode-composer/issues"
  },
  "license": "MIT",
  "sideEffects": false,
  "engines": {
    "node": ">=18.0.0"
  },
  "peerDependencies": {
    "react": ">=17.0.1",
    "react-native": ">=0.64.0",
    "react-native-svg": ">=13.2.0"
  },
  "dependencies": {
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@babel/core": "^7.24.5",
    "@babel/plugin-transform-private-methods": "^7.24.6",
    "@babel/preset-env": "^7.24.6",
    "@babel/preset-typescript": "^7.24.6",
    "@eslint/js": "^9.3.0",
    "@react-native/babel-preset": "^0.74.83",
    "@react-native/eslint-config": "^0.74.83",
    "@release-it/keep-a-changelog": "^5.0.0",
    "@testing-library/react-hooks": "^8.0.1",
    "@testing-library/react-native": "^12.5.0",
    "@types/eslint__js": "^8.42.3",
    "@types/jest": "^29.5.12",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^18.3.1",
    "@types/react-test-renderer": "^18.3.0",
    "babel-jest": "^29.7.0",
    "eslint": "^9.3.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-native": "^4.1.0",
    "globals": "^15.3.0",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "react": "18.3.1",
    "react-native": "0.74.1",
    "react-native-builder-bob": "^0.23.2",
    "react-native-svg": "15.2.0",
    "react-test-renderer": "^18.3.1",
    "release-it": "^17.3.0",
    "typescript": "^5.4.5",
    "typescript-eslint": "^7.11.0"
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      "commonjs",
      "module",
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ],
    "exclude": [
      "**/{__tests__,__fixtures__,__mocks__}/**"
    ]
  }
}
